{
  "name": "oldtimerberater",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright install && playwright test",
    "release": "sh .scripts/release.sh",
    "check:i18n": "inlang check --project ./project.inlang --source ./src/routes ./src/lib",
    "machine-translate": "inlang machine translate --project project.inlang"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/cli": "^3.4.0",
    "@inlang/paraglide-js": "^3.2.2",
    "@inlang/paraglide-js-svelte": "^1.0.5",
    "@inlang/plugin-m-function-matcher": "^2.4.3",
    "@inlang/plugin-message-format": "^4.6.0",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26",
    "@vitest/browser-playwright": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "html-minifier-terser": "^7.2.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.8",
    "vitest-browser-svelte": "^2.1.1"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "^5.3.0"
  }
}
