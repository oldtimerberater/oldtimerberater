{
  "$schema": "https://inlang.com/schema/project-settings",
  "baseLocale": "en",
  "locales": [
    "en",
    "de"
  ],
  "modules": [
    "./node_modules/@inlang/plugin-message-format/dist/index.js",
    "./node_modules/@inlang/plugin-m-function-matcher/dist/index.js"
  ],
  "plugin.inlang.messageFormat": {
    "pathPattern": [
      "./messages/{locale}/common.json",
      "./messages/{locale}/home.json",
      "./messages/{locale}/method.json",
      "./messages/{locale}/advisor.json",
      "./messages/{locale}/contact.json",
      "./messages/{locale}/imprint.json",
      "./messages/{locale}/privacy.json",
      "./messages/{locale}/structured-data.json"
    ]
  }
}
